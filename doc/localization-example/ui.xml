<ui schema="3" width="1280" height="720" initial="title" title-key="title">
  <variables><string id="draftText" initial=""/><string id="draftVoice" initial=""/><int id="count" initial="2"/></variables>
  <screen id="title" modal="false" pause="true">
    <label id="heading" x="180" y="80" width="1020" height="60" text-key="title" font-size="36"/>
    <button id="start" x="80" y="210" width="380" height="55" text-key="start" event="start"/>
    <button id="titleLanguages" x="80" y="290" width="380" height="55" text-key="languages" route="open:languages" visible="locale.enabled"/>
    <button id="titleLoad" x="80" y="370" width="380" height="55" text="读取第 1 槽" event="load"/>
    <button id="titleQuit" x="80" y="450" width="380" height="55" text="退出" event="quit"/>
  </screen>
  <screen id="hud" modal="false" pause="false">
    <label id="speaker" x="80" y="130" width="1100" height="40" bind="game.speaker"/>
    <label id="line" x="80" y="200" width="1100" height="150" bind="game.text" font-size="30"/>
    <label id="argument" x="80" y="360" width="1000" height="40" text-key="counter"><text-arg name="n" bind="ui.count"/></label>
    <button id="next" x="80" y="440" width="200" height="50" bind="game.continueText" event="advance" visible="game.canAdvance"/>
    <repeat id="choices" x="300" y="440" width="700" height="70" source="choices" item-width="650" item-height="50" visible="game.complete"><button id="choice" width="650" height="50" bind="item.text" event="choose"/></repeat>
    <button id="hudLanguages" x="80" y="560" width="250" height="50" text-key="languages" route="open:languages"/>
    <button id="save" x="350" y="560" width="230" height="50" text="保存第 1 槽" event="save"/>
    <button id="load" x="600" y="560" width="230" height="50" text="读取第 1 槽" event="load"/>
    <button id="quit" x="850" y="560" width="160" height="50" text="退出" event="quit"/>
  </screen>
  <screen id="languages" modal="true" pause="true">
    <panel id="languagePanel" x="30" y="30" width="1220" height="660" color="#16202FFF">
      <label id="languageHeading" x="160" y="25" width="1020" height="50" text-key="languages" font-size="32"/>
      <label id="textCaption" x="40" y="100" width="300" height="40" text="文本 / Text"/>
      <label id="voiceCaption" x="620" y="100" width="450" height="40" text="语音 / Voice（占位音频）"/>
      <repeat id="textLocales" x="40" y="155" width="500" height="150" source="textLocales" item-width="450" item-height="50" gap="12"><button id="textLocale" width="450" height="50" bind="item.label" event="text-language"/></repeat>
      <repeat id="voiceLocales" x="620" y="155" width="500" height="150" source="voiceLocales" item-width="450" item-height="50" gap="12"><button id="voiceLocale" width="450" height="50" bind="item.label" event="voice-language"/></repeat>
      <button id="autoText" x="40" y="320" width="450" height="45" text="跟随系统" event="auto-text"/>
      <button id="autoVoice" x="620" y="320" width="450" height="45" text="跟随系统" event="auto-voice"/>
      <label id="textDraft" x="40" y="390" width="450" height="45" bind="ui.draftText"/>
      <label id="voiceDraft" x="620" y="390" width="450" height="45" bind="ui.draftVoice"/>
      <label id="effectiveText" x="40" y="450" width="450" height="45" bind="locale.text"/>
      <label id="effectiveVoice" x="620" y="450" width="450" height="45" bind="locale.voice"/>
      <button id="apply" x="300" y="550" width="250" height="50" text-key="apply" event="apply"/>
      <button id="cancel" x="620" y="550" width="250" height="50" text-key="cancel" route="close"/>
    </panel>
  </screen>
</ui>
