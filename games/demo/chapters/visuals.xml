<?xml version="1.0" encoding="UTF-8"?>
<story schema="8">
  <visuals>
    <visual id="room.empty" background="bg.room" />
    <visual id="room.lin" background="bg.room">
      <portrait character="lin" image="portrait.lin" slot="center" effect="portrait.enter" />
    </visual>
    <visual id="actor.stage" background="bg.room">
      <portrait character="lin" image="portrait.lin" slot="center" pose="normal" enter="none" exit="fade-out" duration="1800" strength="36" />
    </visual>
    <visual id="actor.left" background="bg.room">
      <portrait character="lin" image="portrait.lin" slot="center" pose="normal" enter="enter-left" exit="fade-out" duration="1800" strength="36" />
    </visual>
    <visual id="actor.right" background="bg.room">
      <portrait character="lin" image="portrait.lin" slot="center" pose="normal" enter="enter-right" exit="fade-out" duration="1800" strength="36" />
    </visual>
    <visual id="actor.up" background="bg.room">
      <portrait character="lin" image="portrait.lin" slot="center" pose="normal" enter="enter-up" exit="fade-out" duration="1800" strength="36" />
    </visual>
    <visual id="actor.down" background="bg.room">
      <portrait character="lin" image="portrait.lin" slot="center" pose="normal" enter="enter-down" exit="fade-out" duration="1800" strength="36" />
    </visual>
    <visual id="actor.exit-left" background="bg.room">
