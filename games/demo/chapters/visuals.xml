    </visual>
    <visual id="actor.shake" background="bg.room">
      <portrait character="lin" image="portrait.lin" slot="center" pose="normal" enter="shake" exit="fade-out" duration="1800" strength="36" />
    </visual>
    <visual id="actor.bounce" background="bg.room">
      <portrait character="lin" image="portrait.lin" slot="center" pose="normal" enter="bounce" exit="fade-out" duration="1800" strength="36" />
    </visual>
    <visual id="actor.turn" background="bg.room">
      <portrait character="lin" image="portrait.lin" slot="center" pose="flipped" enter="turn" exit="fade-out" duration="1800" strength="36" />
    </visual>
    <visual id="actor.spin" background="bg.room">
      <portrait character="lin" image="portrait.lin" slot="center" pose="normal" enter="spin" exit="fade-out" duration="1800" strength="36" />
