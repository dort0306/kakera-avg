    <visual id="actor.empty" background="bg.room">
    </visual>
    <visual id="actor.fade-out" background="bg.room">
      <portrait character="lin" image="portrait.lin" slot="center" pose="hidden" enter="fade-out" exit="fade-out" duration="1800" strength="36" />
