  <interface src="ui.xml" />
  <scripts>
    <script src="scripts/endings.js" />
    <script src="scripts/story.js" />
    <script src="scripts/ui.js" />
  </scripts>
  <assets>
    <live2d id="haru" src="assets/live2d/Haru/Haru.model3.json" />
    <video id="video.intro" src="assets/video/intro.mp4" />
    <video id="video.credits" src="assets/video/credits.mp4" />
    <image id="bg.room" src="assets/bg/room.png" />
    <image id="portrait.lin" src="assets/characters/lin.png" />
    <image id="ui.dialogue" src="assets/ui/dialogue.png" />
    <image id="ui.panel" src="assets/ui/panel.png" />
    <image id="ui.button" src="assets/ui/button.png" />
    <image id="ui.hover" src="assets/ui/button-hover.png" />
    <image id="ui.disabled" src="assets/ui/button-disabled.png" />
    <font id="dialogue" src="assets/fonts/chinese.otf" />
    <audio id="bgm.room" src="assets/audio/room.wav" />
    <audio id="se.knock" src="assets/audio/knock.wav" />
    <audio id="voice.lin" src="assets/audio/lin.wav" />
  </assets>
  <effects>
    <image-effect id="portrait.enter" animation="fade-in" duration="800" />
    <image-effect id="fx.gray" filter="grayscale" />
    <image-effect id="fx.sepia" filter="sepia" />
    <image-effect id="fx.blur" filter="blur" blur="4" />
    <image-effect id="fx.pixel" filter="pixelate" pixel-size="24" />
  </effects>

  <variables>
    <int id="trust" label="信任" initial="0" min="0" max="3" />
    <bool id="met" label="已相识" initial="false" />
    <bool id="invited" label="已邀请" initial="false" />
    <string id="mood" label="心情" initial="平静" />
  </variables>

  <characters>
    <character id="lin" name="凛" />
    <character id="haru" name="Haru" />
  </characters>

  <visuals>
    <visual id="room.empty" background="bg.room" />
    <visual id="room.lin" background="bg.room">
      <portrait character="lin" image="portrait.lin" slot="center" effect="portrait.enter" />
    </visual>
    <visual id="actor.stage" background="bg.room">
      <portrait character="lin" image="portrait.lin" slot="center" pose="normal" enter="none" exit="fade-out" duration="1800" strength="36" />
    </visual>
    <visual id="actor.left" background="bg.room">
      <portrait character="lin" image="portrait.lin" slot="center" pose="normal" enter="enter-left" exit="fade-out" duration="1800" strength="36" />
