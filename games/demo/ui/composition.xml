<?xml version="1.0" encoding="UTF-8"?>
<!-- v0.11.2: author composition tags and generic repeat pagination. -->
<ui schema="3">
  <screen id="composition" pause="false">
    <panel id="compositionPanel" x="40" y="20" width="1200" height="680" image="ui.panel">
      <label id="compositionTitle" x="28" y="18" width="700" height="36" text="组合标签与通用分页" font-size="26" color="#F0CA89" />
      <button id="compositionClose" x="1070" y="18" width="88" height="38" text="返回" route="close" image="ui.button" />
      <button id="compositionGalleryTab" x="28" y="68" width="180" height="38" text="画廊分页" event="demo-tab-gallery" image="ui.button" />
      <button id="compositionSlotsTab" x="220" y="68" width="180" height="38" text="手动槽分页" event="demo-tab-slots" image="ui.button" />
      <label id="compositionHint" x="420" y="72" width="620" height="30" text="组件只展开为宿主节点；两个分页 repeat 使用各自的 UI int。" font-size="16" color="#B9C6D2" />

      <x-section id="galleryTab" x="28" y="116" width="560" height="540" heading="画廊（每页 2 项）" open="ui.tabGallery">
        <repeat id="demoGallery" x="0" y="0" width="530" height="380" source="gallery" columns="2" item-width="248" item-height="180" gap="12" page-size="2" page-bind="ui.galleryPage">
          <panel id="demoGalleryCard" width="248" height="180" color="#203449">
            <image id="demoGalleryThumb" x="8" y="8" width="232" height="132" image-bind="item.image" fit="contain" visible="item.unlocked" />
            <label id="demoGalleryLocked" x="70" y="60" width="120" height="26" text="尚未解锁" visible="not:item.unlocked" font-size="18" color="#8195A3" />
            <label id="demoGalleryTitle" x="8" y="146" width="232" height="26" bind="item.title" font-size="17" />
          </panel>
        </repeat>
        <label id="demoGalleryPager" x="0" y="396" width="300" height="30" bind="repeat.galleryTab.demoGallery.pageText" font-size="17" />
        <button id="demoGalleryPrev" x="330" y="392" width="90" height="34" text="上一页" enabled="repeat.galleryTab.demoGallery.canPrev" event="demo-gallery-prev" image="ui.button" hover-image="ui.hover" disabled-image="ui.disabled" font-size="16" />
        <button id="demoGalleryNext" x="430" y="392" width="90" height="34" text="下一页" enabled="repeat.galleryTab.demoGallery.canNext" event="demo-gallery-next" image="ui.button" hover-image="ui.hover" disabled-image="ui.disabled" font-size="16" />
      </x-section>

      <x-section id="slotsTab" x="612" y="116" width="560" height="540" heading="手动槽（每页 10 项）" open="ui.tabSlots">
        <repeat id="demoSlots" x="0" y="0" width="530" height="440" source="slots" columns="2" item-width="248" item-height="80" gap="8" page-size="10" page-bind="ui.slotPage">
          <panel id="demoSlotCard" width="248" height="80" color="#203449">
            <label id="demoSlotTitle" x="10" y="6" width="228" height="24" bind="item.title" font-size="16" color="#F0CA89" />
            <label id="demoSlotPreview" x="10" y="32" width="228" height="42" bind="item.excerpt" font-size="14" />
          </panel>
        </repeat>
        <label id="demoSlotPager" x="0" y="456" width="300" height="30" bind="repeat.slotsTab.demoSlots.pageText" font-size="17" />
        <button id="demoSlotPrev" x="330" y="452" width="90" height="34" text="上一页" enabled="repeat.slotsTab.demoSlots.canPrev" event="demo-slot-prev" image="ui.button" hover-image="ui.hover" disabled-image="ui.disabled" font-size="16" />
        <button id="demoSlotNext" x="430" y="452" width="90" height="34" text="下一页" enabled="repeat.slotsTab.demoSlots.canNext" event="demo-slot-next" image="ui.button" hover-image="ui.hover" disabled-image="ui.disabled" font-size="16" />
      </x-section>
    </panel>
  </screen>
</ui>
